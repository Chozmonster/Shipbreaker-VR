<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Portable publish dir: dist/Mod is zipped for Jay. Override with /p:PublishDir=... -->
    <PropertyGroup>
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
        <PublishDir Condition="'$(PublishDir)' == ''">$(RepoRoot)dist\Mod\</PublishDir>
    </PropertyGroup>
</Project>
