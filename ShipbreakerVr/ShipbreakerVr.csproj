<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>ShipbreakerVr</AssemblyName>
        <Description>Hardspace: Shipbreaker VR mod (Chozmonster fork — auto-VR + VR menus)</Description>
        <Version>0.4.1</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <OutputPath>$(PublishDir)BepInEx\plugins\ShipbreakerVr\</OutputPath>
    </PropertyGroup>

    <Target Name="Copy mod files" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <_ModFiles Remove="@(_ModFiles)"/>
            <_ModFiles Include="ModFiles\**"/>
        </ItemGroup>
        <Copy SourceFiles="@(_ModFiles)" DestinationFiles="$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)"/>
    </Target>

    <!-- Ship XR managed assemblies next to the plugin so OpenXR loads at runtime. -->
    <Target Name="CopyXrRefs" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <_XrRefs Include="$(MSBuildThisFileDirectory)..\libs\xr-managed\Unity.XR.Management.dll"/>
            <_XrRefs Include="$(MSBuildThisFileDirectory)..\libs\xr-managed\Unity.XR.OpenXR.dll"/>
            <_XrRefs Include="$(MSBuildThisFileDirectory)..\libs\xr-managed\Unity.InputSystem.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(_XrRefs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"/>
    </Target>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all"/>
        <PackageReference Include="ShipbreakerGameLibs" Version="1.2.1.260301"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.19"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0"/>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="ModFiles\**"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Unity.InputSystem">
            <HintPath>..\libs\xr-managed\Unity.InputSystem.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Unity.XR.Management">
            <HintPath>..\libs\xr-managed\Unity.XR.Management.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Unity.XR.OpenXR">
            <HintPath>..\libs\xr-managed\Unity.XR.OpenXR.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\ShipbreakerVrUnity\AssetBundles\xrmanager">
            <Link>AssetBundles\xrmanager</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\ShipbreakerVrUnity\AssetBundles\xrmanager.manifest">
            <Link>AssetBundles\xrmanager.manifest</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
